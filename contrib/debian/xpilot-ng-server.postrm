#!/bin/bash

case "$1" in
	purge)
	    rm -f /etc/default/xpilot-ng-cpp-server
	;;
esac

# Normally added by dh_installinit, but included here manually because
# we customize the prerm and therefore run dh_installinit --noscripts.
if [ "$1" = "purge" ] ; then
        update-rc.d xpilot-ng-cpp-server remove >/dev/null
fi

#DEBHELPER#
